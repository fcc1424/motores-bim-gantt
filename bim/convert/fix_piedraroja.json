{"lsKey": "pr2-", "docjs": {"norm": "const C=api.P.imiv;if(!C)return;Object.assign(C.p,api.lsGet('imiv',{}));const $$=api.$$;const out=()=>{const veh=C.S_COM/100*C.p.tc+C.S_GYMU/100*C.p.tg,via=C.S_COM/100*C.p.oc+C.S_GYMU/100*C.p.og;const catV=veh<20?'Exento':veh<=80?'Básico':veh<=200?'Intermedio':'Mayor',catO=via<40?'Exento':via<=160?'Básico':via<=400?'Intermedio':'Mayor';const ord=['Exento','Básico','Intermedio','Mayor'];const cat=ord[Math.max(ord.indexOf(catV),ord.indexOf(catO))];const o=api.$('#imiv-out');if(o)o.innerHTML='<b>'+api.fmt(veh,1)+' veh/h</b> ('+catV+') · <b>'+api.fmt(via,1)+' viajes/h</b> ('+catO+') → IMIV <b>'+cat+'</b>';};$$('[data-imiv]').forEach(i=>{const k=i.dataset.imiv;if(C.p[k]!=null)i.value=C.p[k];i.oninput=()=>{const v=parseFloat(i.value);if(isFinite(v)){C.p[k]=v;api.lsSet('imiv',C.p);out();}};});out();"}, "planOrder": ["acceso", "demol", "canal", "curvas", "curlote", "rev3", "vial", "cercos", "constr", "mob", "arboles", "senal", "lo", "ejes", "tmayor", "bnup", "predio", "puntos", "secc", "faja", "eq9a", "cabext", "cab1", "cab2", "cabn", "arq"]}